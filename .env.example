# proba-audit configuration. Copy to .env for local development.
# Placeholders only: never commit a real .env (it is gitignored).

# Process
NODE_ENV=development
# SERVICE_NAME defaults to the app name (audit-consumer, audit-api, ...)
SERVICE_NAME=
HOST=0.0.0.0
# Each app has its own default: audit-api 3100, audit-consumer 3101,
# metrics-ingester 3102, rollup 3103. Set PORT to override.
PORT=
LOG_LEVEL=info

# Adapter selection. Names are registry keys: add an adapter and register it,
# then set its name here (see docs/ARCHITECTURE.md).
#   EVENT_BUS=redis-streams|memory
#   AUDIT_STORE=clickhouse|memory
#   METRICS_STORE=clickhouse|memory
#   CHECKPOINT_STORE=clickhouse|memory
#   QUARANTINE_STORE=clickhouse|memory
EVENT_BUS=redis-streams
AUDIT_STORE=clickhouse
METRICS_STORE=clickhouse
CHECKPOINT_STORE=clickhouse
QUARANTINE_STORE=clickhouse
# The in-memory adapters (EVENT_BUS, AUDIT_STORE, ... = memory, AUDIT_API_RATE_LIMITER=memory, and ANCHOR_STORE=memory for audit-consumer and audit-api) lose their data on restart
# and are per process, so with NODE_ENV=production the service refuses to start if any is selected.
# true = run them anyway, deliberately (for example to smoke-test a production image). Never for a real deployment.
ALLOW_IN_MEMORY_ADAPTERS=false

# Redis Streams event bus
REDIS_URL=redis://localhost:6379
AUDIT_TOPIC=proba.audit.events
AUDIT_CONSUMER_GROUP=audit-consumer
# Defaults to <hostname>-<pid>
CONSUMER_NAME=
BUS_BATCH_SIZE=100
BUS_BLOCK_MS=2000
# A pending message idle this long is re-delivered to another consumer
BUS_CLAIM_IDLE_MS=60000
# After this many unacked deliveries a message goes to the dead-letter stream
BUS_MAX_DELIVERIES=5
# Optional approximate max stream length (XADD MAXLEN ~)
BUS_MAX_STREAM_LENGTH=

# Audit consumer
# How often it reclaims messages left pending by a crashed consumer
CONSUMER_RECLAIM_INTERVAL_MS=30000
# Backoff when the audit store rejects a batch (doubles up to the maximum)
CONSUMER_RETRY_BASE_MS=500
CONSUMER_RETRY_MAX_MS=30000
# The consumer records its own activity as audit events through the same bus
SELF_AUDIT_ENABLED=true
# Workspace used for self-audit events that belong to no workspace
SELF_AUDIT_WORKSPACE_ID=seedbed

# Metrics ingestion (see docs/ARCHITECTURE.md, "Metrics flow")
# Which connector serves which ad platform: platform:adapter pairs. Empty: the ingester idles.
# meta:stub is the development data source; a real analytics library registers its own name.
PLATFORM_CONNECTORS=meta:stub,google:stub
# The stub refuses to start when NODE_ENV=production unless this is true
ALLOW_STUB_CONNECTOR=false
INGEST_WORKSPACE_ID=seedbed
INGEST_INTERVAL_MS=60000
# Per platform overrides of the interval, for example meta:30000,google:120000
INGEST_INTERVAL_OVERRIDES=
INGEST_JITTER_RATIO=0.1
# hour or day
INGEST_GRANULARITY=hour
INGEST_INITIAL_LOOKBACK_HOURS=48
INGEST_PAGE_SIZE=500
INGEST_MAX_ATTEMPTS=4
INGEST_RETRY_BASE_MS=1000
INGEST_RETRY_MAX_MS=30000
INGEST_MAX_RATE_LIMIT_WAIT_MS=60000
INGEST_FAILURE_BACKOFF_MAX_MS=600000
INGEST_ACCOUNT_REFRESH_MS=300000
# Development data source
STUB_SEED=proba-dev
STUB_RESTATE_EVERY_MINUTES=30
STUB_RESTATE_REVISIONS=2
STUB_FAILURE_RATE=0
# Rollup worker
ROLLUP_INTERVAL_MS=30000
ROLLUP_MAX_WINDOW_DAYS=7

# ClickHouse (HTTP interface)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=proba
CLICKHOUSE_PASSWORD=change-me-locally
CLICKHOUSE_DATABASE=proba_audit
CLICKHOUSE_MIGRATIONS_DIR=migrations/clickhouse
# Least-privilege users (create them with scripts/clickhouse-roles.sql). Each role that is not set falls back to CLICKHOUSE_USER /
# CLICKHOUSE_PASSWORD above, so the single-user local stack needs none of these. A role user needs its own password.
#   consumer: audit-consumer, metrics-ingester, rollup (INSERT + SELECT)   api: audit-api (SELECT only)   migrator: `npm run migrate` (DDL)
CLICKHOUSE_CONSUMER_USER=
CLICKHOUSE_CONSUMER_PASSWORD=
CLICKHOUSE_API_USER=
CLICKHOUSE_API_PASSWORD=
CLICKHOUSE_MIGRATOR_USER=
CLICKHOUSE_MIGRATOR_PASSWORD=

# Raw text of audit events (the protocol's optional `content`: user messages, replies, explanations; secrets are masked by the producer).
# false (default): the consumer drops the text (nothing stored, not even a digest) and the API never returns it.
# true: the consumer stores the text in the ClickHouse table audit_event_content and a SHA-256 digest of it in audit_events (covered by the hash chain),
#       and the API serves it to ADMINS ONLY (GET /v1/events/{id}/content, /v1/traces/{id}/content), auditing every such read.
# Set the same value for audit-consumer and audit-api. Retention: see migrations/clickhouse/0008_audit_event_content.sql.
AUDIT_CONTENT_ENABLED=false
AUDIT_CONTENT_STORE=clickhouse

# Chain anchors (audit-consumer writes them, audit-api checks them). A hash chain proves nothing was edited or removed from the middle,
# but a chain with its NEWEST events deleted is still a valid chain. The consumer therefore records the signed head of every workspace's
# chain (hash, event count, time) OUTSIDE the audit store, and chain verification reports `tail_truncated` when the chain is shorter than,
# or does not contain, that head.
#   ANCHOR_STORE=postgres|memory   postgres: a database the audit store's credentials cannot reach (own user, ideally own server).
#                                  memory: tests and local runs; refused when NODE_ENV=production (see ALLOW_IN_MEMORY_ADAPTERS).
#   ANCHOR_HMAC_KEY                HMAC-SHA256 key that signs the anchors. A SECRET: at least 32 characters, for example `openssl rand -hex 32`.
#                                  Required when NODE_ENV=production; outside production an empty value uses a fixed development key.
#                                  Keep it out of the audit store's environment and out of git.
#   ANCHOR_DATABASE_URL            postgres adapter only; the table is created on first use (migrations/postgres/0002_audit_chain_anchors.sql).
ANCHOR_STORE=memory
ANCHOR_HMAC_KEY=
ANCHOR_DATABASE_URL=
# docker-compose.yml (profile apps) runs its own Postgres for the anchors (service anchor-db); its password:
# ANCHOR_DB_PASSWORD=

# Read API (apps/audit-api). Every value here is configuration, none is a secret.
# Sign-in: verifies the same Firebase ID token the Proba Hub accepts, using Google's public keys.
# adapters: firebase (default) | static (local automated use only, refused when NODE_ENV=production)
AUDIT_API_TOKEN_VERIFIER=firebase
FIREBASE_PROJECT_ID=
# Who may use the API, by verified email (comma separated, case-insensitive). Everything empty = nobody.
# Viewers read events, traces and analytics; admins can also verify the hash chain.
AUDIT_API_ALLOWED_EMAILS=
AUDIT_API_ALLOWED_EMAIL_DOMAINS=
AUDIT_API_ADMIN_EMAILS=
# The workspace this deployment serves (the Hub has one default workspace).
AUDIT_API_WORKSPACE_ID=seedbed
# Exact browser origins allowed to call the API, for example the insights portal. Empty = none.
AUDIT_API_CORS_ORIGINS=http://localhost:5173
# Behind a reverse proxy: trust X-Forwarded-For for the client address (rate limiting).
AUDIT_API_TRUST_PROXY=false
# Rate limiter adapter: memory | redis (redis shares limits between replicas)
AUDIT_API_RATE_LIMITER=memory
# Requests per window per signed-in user; chain verification has its own lower limit.
AUDIT_API_RATE_LIMIT_MAX=120
AUDIT_API_RATE_LIMIT_WINDOW_MS=60000
AUDIT_API_CHAIN_RATE_LIMIT_MAX=6
# Rejected sign-ins per client address before it is refused for a while.
AUDIT_API_AUTH_FAILURE_LIMIT_MAX=30
AUDIT_API_AUTH_FAILURE_WINDOW_MS=900000
# Which ad accounts belong to the workspace for analytics (the metrics tables are keyed by account):
#   connectors = the accounts the configured PLATFORM_CONNECTORS report; static = AUDIT_API_ANALYTICS_ACCOUNTS
AUDIT_API_SCOPE_SOURCE=connectors
# platform:accountId pairs, for example meta:act_123,google:456-789
AUDIT_API_ANALYTICS_ACCOUNTS=
AUDIT_API_SCOPE_CACHE_MS=60000
# Chain verification bounds per request
AUDIT_API_CHAIN_MAX_RANGE_HOURS=24
AUDIT_API_CHAIN_MAX_EVENTS=100000

# docker-compose host ports (only needed if the defaults clash)
# REDIS_HOST_PORT=6379
# CLICKHOUSE_HTTP_HOST_PORT=8123
# AUDIT_API_HOST_PORT=3100

# Integration tests of the Postgres outbox adapter (docker compose --profile test up -d postgres)
# OUTBOX_TEST_DATABASE_URL=postgresql://proba:proba@localhost:5432/proba_audit_outbox_test
# POSTGRES_HOST_PORT=5432
