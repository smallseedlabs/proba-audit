# proba-audit configuration. Copy to .env for local development.
# Placeholders only: never commit a real .env (it is gitignored).

# Process
NODE_ENV=development
# SERVICE_NAME defaults to the app name (audit-consumer, audit-api, ...)
SERVICE_NAME=
HOST=0.0.0.0
# Each app has its own default: audit-api 3100, audit-consumer 3101,
# metrics-ingester 3102, rollup 3103. Set PORT to override.
PORT=
LOG_LEVEL=info

# Adapter selection. Names are registry keys: add an adapter and register it,
# then set its name here (see docs/ARCHITECTURE.md).
#   EVENT_BUS=redis-streams|memory
#   AUDIT_STORE=clickhouse|memory
#   METRICS_STORE=clickhouse|memory
#   CHECKPOINT_STORE=clickhouse|memory
#   QUARANTINE_STORE=clickhouse|memory
EVENT_BUS=redis-streams
AUDIT_STORE=clickhouse
METRICS_STORE=clickhouse
CHECKPOINT_STORE=clickhouse
QUARANTINE_STORE=clickhouse

# Redis Streams event bus
REDIS_URL=redis://localhost:6379
AUDIT_TOPIC=proba.audit.events
AUDIT_CONSUMER_GROUP=audit-consumer
# Defaults to <hostname>-<pid>
CONSUMER_NAME=
BUS_BATCH_SIZE=100
BUS_BLOCK_MS=2000
# A pending message idle this long is re-delivered to another consumer
BUS_CLAIM_IDLE_MS=60000
# After this many unacked deliveries a message goes to the dead-letter stream
BUS_MAX_DELIVERIES=5
# Optional approximate max stream length (XADD MAXLEN ~)
BUS_MAX_STREAM_LENGTH=

# Audit consumer
# How often it reclaims messages left pending by a crashed consumer
CONSUMER_RECLAIM_INTERVAL_MS=30000
# Backoff when the audit store rejects a batch (doubles up to the maximum)
CONSUMER_RETRY_BASE_MS=500
CONSUMER_RETRY_MAX_MS=30000
# The consumer records its own activity as audit events through the same bus
SELF_AUDIT_ENABLED=true
# Workspace used for self-audit events that belong to no workspace
SELF_AUDIT_WORKSPACE_ID=seedbed

# Metrics ingestion (see docs/ARCHITECTURE.md, "Metrics flow")
# Which connector serves which ad platform: platform:adapter pairs. Empty: the ingester idles.
# meta:stub is the development data source; a real analytics library registers its own name.
PLATFORM_CONNECTORS=meta:stub,google:stub
# The stub refuses to start when NODE_ENV=production unless this is true
ALLOW_STUB_CONNECTOR=false
INGEST_WORKSPACE_ID=seedbed
INGEST_INTERVAL_MS=60000
# Per platform overrides of the interval, for example meta:30000,google:120000
INGEST_INTERVAL_OVERRIDES=
INGEST_JITTER_RATIO=0.1
# hour or day
INGEST_GRANULARITY=hour
INGEST_INITIAL_LOOKBACK_HOURS=48
INGEST_PAGE_SIZE=500
INGEST_MAX_ATTEMPTS=4
INGEST_RETRY_BASE_MS=1000
INGEST_RETRY_MAX_MS=30000
INGEST_MAX_RATE_LIMIT_WAIT_MS=60000
INGEST_FAILURE_BACKOFF_MAX_MS=600000
INGEST_ACCOUNT_REFRESH_MS=300000
# Development data source
STUB_SEED=proba-dev
STUB_RESTATE_EVERY_MINUTES=30
STUB_RESTATE_REVISIONS=2
STUB_FAILURE_RATE=0
# Rollup worker
ROLLUP_INTERVAL_MS=30000
ROLLUP_MAX_WINDOW_DAYS=7

# ClickHouse (HTTP interface)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=proba
CLICKHOUSE_PASSWORD=change-me-locally
CLICKHOUSE_DATABASE=proba_audit
CLICKHOUSE_MIGRATIONS_DIR=migrations/clickhouse

# docker-compose host ports (only needed if the defaults clash)
# REDIS_HOST_PORT=6379
# CLICKHOUSE_HTTP_HOST_PORT=8123

# Integration tests of the Postgres outbox adapter (docker compose --profile test up -d postgres)
# OUTBOX_TEST_DATABASE_URL=postgresql://proba:proba@localhost:5432/proba_audit_outbox_test
# POSTGRES_HOST_PORT=5432
