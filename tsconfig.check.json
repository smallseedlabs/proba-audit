{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@smallseedlabs/proba-audit-core": ["packages/core/src/index.ts"],
      "@smallseedlabs/proba-audit-core/testing": ["packages/core/src/testing/index.ts"],
      "@smallseedlabs/proba-audit-adapters": ["packages/adapters/src/index.ts"]
